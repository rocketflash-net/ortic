{
  "name": "ortic",
  "private": true,
  "packageManager": "npm@11.6.3",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "install:all": "npm install",
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@ortic/web",
    "dev:admin": "turbo run dev --filter=@ortic/admin",
    "dev:api": "turbo run dev --filter=@ortic/api",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check"
  },
  "devDependencies": {
    "turbo": "^2.11.5"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.28.2"
    },
    "fontless": {
      "esbuild": "^0.28.2"
    }
  }
}
