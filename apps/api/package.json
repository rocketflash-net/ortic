{
  "name": "@ortic/api",
  "version": "1.0.0",
  "description": "Ortic REST API (Express 5 + Drizzle ORM + MySQL)",
  "main": "build/index.js",
  "private": true,
  "scripts": {
    "dev": "node --watch-path=src --env-file-if-exists=.env -r ts-node/register src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node build/index.js",
    "format": "prettier ./src --write",
    "db:generate": "drizzle-kit generate",
    "db:generate:custom": "drizzle-kit generate --custom",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:prod": "node build/database/migrate.js",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:check": "drizzle-kit check",
    "db:seed": "ts-node src/database/seed.ts",
    "admin": "ts-node src/cli/admin.cli.ts",
    "admin:prod": "node build/cli/admin.cli.js",
    "postbuild": "node -e \"require('fs').cpSync('src/database/migrations','build/database/migrations',{recursive:true})\"",
    "type-check": "tsc --noEmit",
    "db:seed:demo-stock": "ts-node src/database/seed-demo-stock.ts"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1147.0",
    "@aws-sdk/s3-request-presigner": "^3.1147.0",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "csv-parse": "^6.2.1",
    "csv-stringify": "^6.9.0",
    "dotenv": "^18.0.5",
    "drizzle-orm": "^0.45.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "http-status-codes": "^2.3.0",
    "jose": "^6.2.12",
    "module-alias": "^2.3.4",
    "mysql2": "^3.24.5",
    "nodemailer": "^10.0.16",
    "pino": "^10.4.0",
    "sanitize-html": "^2.18.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/module-alias": "^2.0.4",
    "@types/node": "^26.6.4",
    "@types/nodemailer": "^8.0.2",
    "@types/sanitize-html": "^2.16.2",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.9",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
