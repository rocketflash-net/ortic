# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME=Ortic API
# local | development | staging | sandbox | production
NODE_ENV=local
PORT=4000
# Jumlah reverse proxy di depan API (untuk IP asli di rate limit). 0 = tanpa proxy.
TRUST_PROXY=1

# Log request/response (field sensitif di-mask)
USE_LOGGER=true
# fatal | error | warn | info | debug | trace | silent (default: info di production, debug selain itu)
LOG_LEVEL=
USE_COMPRESSION=false
USE_LIMITER=false
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=6000
# Batas minta & verifikasi kode OTP login per IP
AUTH_EMAIL_RATE_LIMIT_WINDOW_MS=600000
AUTH_EMAIL_RATE_LIMIT_MAX=60
# Pencarian area Biteship (autocomplete alamat), per IP
AREA_SEARCH_RATE_LIMIT_WINDOW_MS=60000
AREA_SEARCH_RATE_LIMIT_MAX=30

# Job berkala: order QRIS kedaluwarsa, hapus session & kode login lama
EXPIRATION_JOB_INTERVAL_MS=60000

# ---------------------------------------------------------------------------
# Frontend (CORS, redirect login Google)
# ---------------------------------------------------------------------------
# Toko untuk pembeli (apps/web) — production: https://ortic.id
WEB_URL=http://localhost:5600
# Dashboard admin (apps/admin) — production: https://admin.ortic.id
ADMIN_URL=http://localhost:5700
# Origin tambahan, dipisah koma (opsional)
CORS_ORIGINS=

# ---------------------------------------------------------------------------
# Database (MySQL)
# ---------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=ortic
DB_POOL_MAX=10
DB_LOGGING=false

# ---------------------------------------------------------------------------
# Auth (Google OAuth / OTP email) — token di header Authorization: Bearer
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/auth/google/callback
# Secret tanda tangan access token (JWT HS256), wajib di production, min. 32 karakter.
# Buat dengan: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Masa berlaku sesi / refresh token (hari, absolut sejak login). Access token selalu 15 menit.
SESSION_TTL_DAYS=30
# Admin dibuat lewat CLI: npm run admin -- grant <email>

# ---------------------------------------------------------------------------
# Email (kode OTP login)
# ---------------------------------------------------------------------------
# log | onesignal | smtp (log = isi email ditulis ke log, ditolak di production)
MAIL_PROVIDER=log
# Dummy OTP (development saja, ditolak di production): kode login email selalu nilai ini, mis. 123456.
# Kosongkan untuk kode acak (dengan MAIL_PROVIDER=log, kode tetap terlihat di log API).
AUTH_DEV_LOGIN_CODE=
# OneSignal Email: Dashboard OneSignal > Settings > Keys & IDs. Pengirim & domain diatur di Email Settings OneSignal.
ONESIGNAL_APP_ID=
ONESIGNAL_API_KEY=
# Hanya untuk SMTP
MAIL_FROM="Ortic <no-reply@ortic.id>"
# SMTP provider apa pun (Resend, Brevo, SES, dll). Port 465 -> SMTP_SECURE=true
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# ---------------------------------------------------------------------------
# Payment (QRIS)
# ---------------------------------------------------------------------------
# batpay | mock (mock = provider palsu untuk development, ditolak di production)
PAYMENT_PROVIDER=mock
PAYMENT_ORDER_TTL_MINUTES=15
# Hanya untuk provider mock (header x-callback-token)
PAYMENT_WEBHOOK_TOKEN=change-me

# ---------------------------------------------------------------------------
# Pesanan
# ---------------------------------------------------------------------------
# true = pesanan lunas langsung diproses; false = admin harus klik Terima di dashboard
AUTO_ACCEPT_ORDERS=true
# MDR QRIS (ditanggung pemilik, hanya untuk laporan laba). Default kriteria merchant UMI:
# transaksi <= QRIS_MDR_FREE_MAX bebas MDR, di atasnya dikenai QRIS_MDR_RATE (0.003 = 0,3%)
QRIS_MDR_RATE=0.003
QRIS_MDR_FREE_MAX=100000

# ---------------------------------------------------------------------------
# Biteship (ongkir, booking + pickup, tracking) — https://biteship.com/id/docs
# ---------------------------------------------------------------------------
BITESHIP_BASE_URL=https://api.biteship.com
# API key dari dashboard Biteship (testing key untuk sandbox)
BITESHIP_API_KEY=
# true = cek ongkir memakai respons palsu (bentuk sama persis dengan API Biteship), selama saldo belum diisi.
# Set false setelah top up. Ditolak saat NODE_ENV=production.
BITESHIP_MOCK_RATES=true
# true = booking kurir (POST /v1/orders) memakai resi palsu dan status pengiriman bisa disimulasikan dari dashboard
# (tombol "Simulasi status berikutnya"). Default mengikuti BITESHIP_MOCK_RATES. Ditolak saat NODE_ENV=production.
BITESHIP_MOCK_ORDERS=true
# Webhook status pengiriman: URL {API_URL}/api/v1/webhooks/biteship. Di dashboard Biteship isi "Signature Key" = header
# di bawah dan "Signature Secret" = secret di bawah. Buat secret: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
BITESHIP_WEBHOOK_HEADER=x-ortic-webhook-secret
BITESHIP_WEBHOOK_SECRET=
# Cek ulang status pengiriman ke Biteship (cadangan webhook), per pesanan. Default 2 jam.
BITESHIP_TRACKING_INTERVAL_MS=7200000
# Cache hasil cek ongkir untuk rute+berat+kurir yang sama. Default 24 jam.
BITESHIP_RATES_CACHE_TTL_MS=86400000
# Seberapa sering job pengiriman (booking ulang + rekonsiliasi) berjalan.
SHIPMENT_JOB_INTERVAL_MS=300000

# ---------------------------------------------------------------------------
# BatPay Open API (SNAP) — https://developer.batbiz.id
# ---------------------------------------------------------------------------
# Sandbox yang dipakai (akun sandbox kesan-invitation): https://sg-openapi.batbiz.id · Production: https://openapi.batbiz.id
BATPAY_BASE_URL=https://sg-openapi.batbiz.id
# Kredensial dari BatPay (X-CLIENT-KEY, X-PARTNER-ID, secret HMAC, MID)
BATPAY_CLIENT_KEY=
BATPAY_PARTNER_ID=
BATPAY_SECRET_KEY=
BATPAY_MERCHANT_ID=
BATPAY_CHANNEL_ID=95221
# Private key RSA 2048 kita (PKCS#8). Public key pasangannya di-upload ke BatPay.
# Isi path file, atau isi langsung (boleh satu baris dengan \n).
BATPAY_PRIVATE_KEY_PATH=
BATPAY_PRIVATE_KEY=
# Public key BatPay untuk memverifikasi callback (lihat "Digital Signature" di developer.batbiz.id; beda sandbox & production)
BATPAY_PUBLIC_KEY_PATH=
BATPAY_PUBLIC_KEY=
# Secret acak (min. 32 karakter) untuk access token yang kita berikan ke BatPay saat callback
BATPAY_CALLBACK_TOKEN_SECRET=
BATPAY_CALLBACK_TOKEN_TTL_SECONDS=900
BATPAY_MAX_TIMESTAMP_SKEW_SECONDS=300
BATPAY_TIMEOUT_MS=15000

# ---------------------------------------------------------------------------
# Object storage S3-compatible (MinIO lokal / Cloudflare R2)
# ---------------------------------------------------------------------------
# s3 = R2/MinIO; local = file disimpan di ortic/storage (STORAGE_LOCAL_DIR) dan disajikan API di /storage (development tanpa Docker).
# Untuk local, set STORAGE_PUBLIC_URL=http://localhost:4000/storage
STORAGE_DRIVER=s3
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=auto
STORAGE_BUCKET=ortic
STORAGE_ACCESS_KEY_ID=minioadmin
STORAGE_SECRET_ACCESS_KEY=minioadmin
STORAGE_FORCE_PATH_STYLE=true
STORAGE_PUBLIC_URL=http://localhost:9000/ortic
STORAGE_PRESIGN_EXPIRES_SECONDS=300
